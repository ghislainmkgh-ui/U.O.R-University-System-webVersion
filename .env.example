# Web app environment only. Copy to .env in this folder.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-for-web-app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# MySQL database used by the web app.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=uor_university
DB_PORT=3306

# Web-local runtime paths.
WEB_FRONTEND_URL=http://127.0.0.1:5173
WEB_BACKEND_PUBLIC_URL=http://127.0.0.1:8000
WEB_STORAGE_ROOT=
WEB_LOG_DIR=

# JWT API auth
JWT_EXPIRATION=3600

# Email and WhatsApp integrations
EMAIL_SERVICE=gmail
EMAIL_ADDRESS=
EMAIL_PASSWORD=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM=

# ESP32 and IP camera
ACCESS_SERVER_AUTOSTART=True
ACCESS_SERVER_HOST=0.0.0.0
ESP32_HOST=127.0.0.1
ESP32_PORT=5050
ACCESS_ENTRY_SESSION_TTL_SEC=12
ACCESS_ROOM_STATE_STALE_SEC=300
ACCESS_AUTHORITY_BADGES=
IP_CAMERA_TYPE=v720
IP_CAMERA_URL=
IP_CAMERA_SNAPSHOT_URL=
IP_CAMERA_USERNAME=
IP_CAMERA_PASSWORD=
CAMERA_DEVICE_ID=
IP_CAMERA_CAPTURE_PRIORITY=snapshot,rtsp,ftp
IP_CAMERA_FTP_ENABLED=False
IP_CAMERA_FTP_HOST=
IP_CAMERA_FTP_PORT=21
IP_CAMERA_FTP_PATH=/tmp/motion.jpg
IP_CAMERA_FTP_USERNAME=
IP_CAMERA_FTP_PASSWORD=
IP_CAMERA_AUTO_DISCOVERY_ENABLED=False
IP_CAMERA_DISCOVERY_SUBNET=192.168.1.
IP_CAMERA_DISCOVERY_IP_RANGE=1-254

# Face recognition
FACE_RECOGNITION_TOLERANCE=0.50
FACE_REJECT_MULTIPLE_FACES=True
FACE_CAPTURE_ATTEMPTS=3
FACE_CAPTURE_RETRY_DELAY_MS=350
FACE_MIN_MATCH_SUCCESSES=3
FACE_MAX_PROCESSING_WIDTH=640
FACE_REFERENCE_CACHE_TTL_SEC=300
FACE_ENABLE_CLAHE_FALLBACK=True

# Super Admin remote approval links.
# When the backend starts, it can open a localtunnel URL to this Django backend.
# Leave ACCESS_APPROVAL_BASE_URL empty to use the generated tunnel URL.
ACCESS_APPROVAL_AUTOSTART=True
ACCESS_APPROVAL_TUNNEL_AUTOSTART=True
ACCESS_APPROVAL_TUNNEL_PROVIDER=localtunnel
ACCESS_APPROVAL_TUNNEL_HOST=127.0.0.1
ACCESS_APPROVAL_TUNNEL_PORT=8000
ACCESS_APPROVAL_TUNNEL_SUBDOMAIN=
ACCESS_APPROVAL_BASE_URL=
ACCESS_APPROVAL_TOKEN_TTL_HOURS=72
ACCESS_APPROVAL_TOKEN_SECRET=
